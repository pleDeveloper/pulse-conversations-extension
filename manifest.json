{
  "manifest_version": 3,
  "name": "Pulse Conversations",
  "version": "0.1.0",
  "description": "Side-panel viewer for Pulse live transcripts stored on ple__Meeting__c.",
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.my.salesforce.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Pulse Conversations",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
